# Salin file ini jadi `.env` lalu isi nilainya masing-masing.
# JANGAN pernah commit file `.env` yang asli (sudah ada di .gitignore).

# Port server Express jalan (Railway/hosting lain biasanya inject ini otomatis,
# boleh dikosongin di production)
PORT=5000

# Koneksi database MySQL
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=db_cv_anugrah_gemilang_dev

# Secret buat sign JWT access token & refresh token - HARUS string acak yang panjang &
# unik per environment (dev/staging/production beda-beda). Contoh generate:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# Daftar origin (URL frontend) yang diizinkan akses API ini, dipisah koma, TANPA spasi
# setelah koma & TANPA trailing slash. Contoh production:
# ALLOWED_ORIGINS=https://nama-app-kamu.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
